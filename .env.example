# Stack Docker (docker-compose.yml na raiz). Copie para .env: make setup
# Documentação: https://docs.docker.com/compose/environment-variables/

# ─── MongoDB ───
# Scripts na máquina host (make db-migrate, service/) com o Mongo no Docker (porta 27017 em 127.0.0.1).
# Nome do DB alinhado às migrations em database/migrations (coleção "rpg").
MONGO_URI=mongodb://127.0.0.1:27017
RPG_DATABASE=rpg
# Exemplo de enunciado com nome dedicado (exige migrations apontando para o mesmo DB):
# MONGO_URI=mongodb://127.0.0.1:27017/khonum_db
# RPG_DATABASE=khonum_db

# DNS interno do Compose (o serviço backend usa mongodb://db:27017 definido em docker-compose.yml):
# MONGO_URI_DOCKER=mongodb://db:27017/khonum_db

# ─── Backend (API exposta no host em BACKEND_PORT → mapeada para 5000 no container) ───
PORT=5000
BACKEND_PORT=5000
FLASK_ENV=development
# Nível de log do backend: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-me-use-a-long-random-string
FLASK_HOST=0.0.0.0

# Admin inicial (seed ao subir o backend)
ADMIN_USER=
ADMIN_PASSWORD=

# CORS: origem do Vite no navegador (host)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Frontend (navegador no host chama a API em localhost na porta do backend) ───
# Compatível com Create React App (nome legado); o Vite usa VITE_*.
REACT_APP_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
FRONTEND_PORT=5173

# ─── Scripts na raiz (migrations, service/) sem Docker ───
# Se usar apenas MongoDB local na máquina, use mongodb://localhost:27017
# MONGO_URI=mongodb://localhost:27017
