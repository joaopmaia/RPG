# Copie para .env (não versionar): cp .env.example .env

# Admin inicial (seed)
ADMIN_USER=
ADMIN_PASSWORD=

# JWT / assinatura de tokens (use uma string longa e aleatória em produção)
JWT_SECRET_KEY=
# Legado (se JWT_SECRET_KEY vazio, o Flask usa isto)
FLASK_SECRET_KEY=

# Porta HTTP (PaaS costuma definir PORT; localmente usa FLASK_PORT se PORT vazio)
PORT=
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Ambiente: development | production (produção exige CORS_ALLOWED_ORIGINS)
FLASK_ENV=development

# MongoDB (no Docker Compose da raiz: mongodb://localhost:27017)
MONGO_URI=mongodb://localhost:27017
RPG_DATABASE=rpg

# Origens CORS permitidas (separadas por vírgula). Em produção é obrigatório.
# CORS_ALLOWED_ORIGINS=https://app.seudominio.com
CORS_ALLOWED_ORIGINS=

# Em background (nohup): desativa reloader do Flask
# RUN_IN_BACKGROUND=1
