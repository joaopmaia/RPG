# Credenciais do usuário admin. Copie para .env e preencha (não versionar .env):
#   cp .env.example .env

ADMIN_USER=
ADMIN_PASSWORD=

# Chave secreta do Flask (sessões/JWT). Gere uma string aleatória forte em produção.
FLASK_SECRET_KEY=

# Porta em que o backend sobe (padrão: 5000).
FLASK_PORT=5000

# MongoDB. Padrão para desenvolvimento local.
MONGO_URI=mongodb://localhost:27017
RPG_DATABASE=rpg

# Origens CORS permitidas (separadas por vírgula). Opcional.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Em background (nohup): desativa reloader do Flask.
# RUN_IN_BACKGROUND=1
