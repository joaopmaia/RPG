# URL base da API (sem /api no final). Ex.: https://api.seudominio.com
# Em desenvolvimento pode ficar vazio: o Vite faz proxy de /api para o backend local.
VITE_API_URL=

# Nome legado (Create React App); no Vite use VITE_API_URL. Stack Docker: ver .env na raiz.
# REACT_APP_API_URL=http://localhost:5000

# Alvo do proxy em dev (vite.config.js). Opcional; padrão http://localhost:5000
# No Docker, o compose define VITE_DEV_PROXY_TARGET=http://backend:5000
# VITE_DEV_PROXY_TARGET=http://localhost:5000
